# Configuration a deployed instance needs, with no values.
#
# Nothing here is required to run locally: backend/compose.yaml supplies a database and Boot's
# docker-compose support wires it up, so `npm run dev` needs no environment at all. These are the
# variables a real deployment must set instead, because the local credentials in compose.yaml are
# local-only and must never travel.
#
# Copy to .env and fill in. .env is gitignored; this file is not.

# Where the database is, and who connects to it. Standard Spring Boot names, so nothing in the
# application has to know these exist. See ADR-004.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# The RSA private key every access token is signed with, as a PKCS#8 PEM of at least 2048 bits.
# Generate one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072
# Required in every deployment: without it the application refuses to start, rather than invent a
# key that would not survive a restart and that a second instance could not verify. `npm run dev`
# needs none, because `spring-boot:run` permits a throwaway key instead. Never commit a real one.
# See ADR-011.
HRSCHED_SECURITY_TOKEN_PRIVATEKEY=
