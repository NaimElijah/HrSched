# Build output
target/
build/
dist/
coverage/
node_modules/
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

# Maven wrapper downloads its own distribution; the jar is not committed.
# Globbed, not anchored: the wrapper lives in backend/, not at the repository root.
**/.mvn/wrapper/maven-wrapper.jar

# Secrets
.env
.env.*
!.env.example

# Editors / IDEs
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
.classpath
.project
.settings/
.factorypath
.apt_generated

# OS
.DS_Store
Thumbs.db
desktop.ini

# Agent state — .claude/ itself stays tracked, only local state is ignored
.claude/settings.local.json
# Snapshots and console logs the Playwright MCP browser tools write into the working directory
.playwright-mcp/
