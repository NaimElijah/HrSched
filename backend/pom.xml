<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  Spring Boot's parent, and through it the BOM that sets the version of everything Boot
	  manages below, so a Boot release moves them together instead of each by hand. Maintained by
	  the Spring team. Apache-2.0. See ADR-001.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>io.github.naimelijah</groupId>
	<artifactId>hrsched</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>HrSched</name>
	<description>Staff shift scheduling</description>

	<properties>
		<java.version>21</java.version>
		<!--
		  Ahead of the 1.62.0 the Boot BOM manages, for GHSA-ccrj-gw8r-854m: before 1.67.0, the W3C
		  propagator parses an inbound tracestate header in quadratic time, and this service
		  extracts inbound trace headers from unauthenticated requests. Overrides the property the
		  Boot BOM imports opentelemetry-bom with. Removing it once Boot manages 1.67.0 or later
		  is #289.
		-->
		<opentelemetry.version>1.67.0</opentelemetry.version>
		<spotless.version>3.10.4</spotless.version>
		<!--
		  The formatter Spotless enforces. Maintained by Google, Apache-2.0. Kept current by hand:
		  it is read only inside the plugin's configuration, where Dependabot does not look. Not the
		  newest, because the newest fails under this Spotless (#281).
		-->
		<google-java-format.version>1.27.0</google-java-format.version>
		<archunit.version>1.5.1</archunit.version>
		<jacoco.version>0.8.15</jacoco.version>
		<!--
		  Not the newest. From 9.13 on, OR-Tools' Windows libraries need the Visual C++ runtime 14.40
		  or later, and the JDK 21 a developer runs here bundles 14.36, which Windows loads first:
		  the JVM crashes on the first solve. 9.12 is the newest that runs on it. Dependabot ignores
		  9.13 and later until that changes. See ADR-044.
		-->
		<ortools.version>9.12.4544</ortools.version>
		<jna.version>5.19.1</jna.version>
	</properties>

	<dependencies>
		<!--
		  The HTTP boundary: Spring MVC on an embedded Tomcat, which every web adapter is written
		  against. The JDK's own HTTP server has no routing, binding or validation. Maintained by
		  the Spring team, Apache-2.0, version-managed by the Boot BOM. See ADR-001.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!--
		  Health and readiness endpoints are a baseline requirement for every service, and the
		  metrics endpoints of ADR-017 hang off the same machinery. Nothing in the JDK serves them.
		  Maintained by the Spring team, Apache-2.0, version-managed by the Boot BOM.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!--
		  Vendor-neutral instrumentation, which ADR-001 names as a baseline demand. Supplies the
		  OpenTelemetry API, the Micrometer Tracing bridge over it, and the OTLP exporters, so a
		  W3C trace id exists on every request and reaches the log lines it produces. The JDK has no
		  tracing API. The exporters stay switched off until Q19 is answered. Maintained by the
		  Spring team, Apache-2.0, version-managed by the Boot BOM, except OpenTelemetry itself, which
		  opentelemetry.version above holds ahead of it (#289). See ADR-016.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-opentelemetry</artifactId>
		</dependency>
		<!--
		  Renders the meters Micrometer already collects in the format a scraper reads, in place of
		  a hand-written exposition-format encoder. Nothing pushes: metrics are pulled from
		  /actuator/prometheus, which the chain refuses to every caller until a scraper exists
		  (ADR-049). Maintained by the Micrometer project, Apache-2.0, version-managed by the Boot
		  BOM through micrometer-bom. See ADR-017.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!--
		  Storage. JdbcClient and a DataSource, with no ORM: the domain may not carry
		  jakarta.persistence annotations (the architecture test fails on them), so an ORM would need
		  a parallel annotated model anyway and would contribute only behaviour the adapter must not
		  leak. The JDK's own JDBC has no connection pool and no transaction manager for the use
		  cases to share. Maintained by the Spring team, Apache-2.0, version-managed by the Boot BOM.
		  See ADR-004.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<!--
		  Versioned schema migrations as plain SQL, applied on startup. Chosen over Liquibase because
		  the migrations are SQL and Flyway lets them stay SQL. Flyway is maintained by Redgate, the
		  starter by the Spring team. Apache-2.0, BOM-managed. See ADR-004.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<!--
		  Flyway ships each database's support as a module of its own; without this one it cannot
		  migrate PostgreSQL. Maintained by Redgate with Flyway itself, Apache-2.0, BOM-managed.
		-->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<!--
		  The PostgreSQL JDBC driver; the JDK ships none. Runtime only: nothing compiles against
		  it. Maintained by the pgJDBC project, BSD-2-Clause, version-managed by the Boot BOM. See
		  ADR-004.
		-->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!--
		  Starts the Postgres in compose.yaml when the application is run locally, and stops it after.
		  Optional, so it never reaches a deployed artifact; Boot skips it under test, where
		  Testcontainers supplies the database instead. Keeps scripts/run.mjs free of build logic,
		  which ADR-014 requires of it. Maintained by the Spring team, Apache-2.0, BOM-managed.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-docker-compose</artifactId>
			<optional>true</optional>
		</dependency>

		<!--
		  Spring Security's filter chain, plus JWT signing and verification (Nimbus JOSE+JWT) for
		  the access tokens ADR-011 issues. SecurityConfiguration builds one chain that names who
		  may call each route and ends in denyAll (ADR-032). The JDK has the signature primitives,
		  but no JWT format and no request filter chain, and neither is something to hand-write.
		  Maintained by the Spring team (Nimbus by Connect2id), and version-managed by the Boot
		  BOM. Apache-2.0. See ADR-011.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
		</dependency>

		<!--
		  Roster generation: CP-SAT, the constraint solver in Google OR-Tools, reached over JNI. It
		  replaces the greedy placeholder ADR-005 shipped; an exact optimiser for a 0-1 problem of
		  this size is not something to write by hand. Brings native libraries for five platforms
		  and protobuf-java, which the Boot BOM already manages. Confined to
		  scheduling.adapter.out.generation. Apache-2.0, maintained by Google, and pinned because no
		  BOM manages it; held at 9.12 on purpose (see ortools.version above). Its native jars also
		  bundle COIN-OR, HiGHS, Abseil, protobuf, RE2 and zlib libraries under their own licences,
		  which its POM does not declare (#280). See ADR-044.
		-->
		<dependency>
			<groupId>com.google.ortools</groupId>
			<artifactId>ortools-java</artifactId>
			<version>${ortools.version}</version>
		</dependency>

		<!--
		  Spring's test support for the web layer: MockMvc, plus the test starter with JUnit,
		  AssertJ and Mockito, which Boot 4 brings in per technology. Maintained by the Spring team,
		  Apache-2.0, version-managed by the Boot BOM.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  The test support behind @AutoConfigureMetrics, which MetricsHttpTest needs because Boot
		  switches metrics export off under test. Same team, licence and BOM management.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  Enforces the hexagon. Nothing in the JDK, Maven, or Spring can fail a build when the
		  domain imports a framework type; without this the dependency rule is only a comment.
		  Maintained by TNG Technology Consulting, Apache-2.0, and pinned because no BOM manages it;
		  Dependabot proposes each release. See ADR-003.
		-->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
		<!--
		  The tests run against a real PostgreSQL in a container, so Docker is required to build.
		  There is deliberately no in-memory fallback and no skip-when-Docker-is-absent: a check that
		  quietly does not run still reports green, which is what ci.yml already refuses for path
		  filters. This is Boot's Testcontainers support. No test source imports from it, and the
		  suite does not use @ServiceConnection: PostgresDatabase starts the one container and
		  PostgresBackedApplication hands Spring only its address (#252). Apache-2.0, maintained
		  by the Spring team, and version-managed by the Boot BOM. See ADR-004.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  Runs that PostgreSQL; nothing in the JDK or in Spring starts a container. MIT, maintained
		  by the Testcontainers project. Version-managed by the Boot BOM, which imports
		  testcontainers-bom, so it moves when Boot does.
		-->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<!--
			  Nothing in backend/src uses JNA itself. OR-Tools asks for JNA 5.14.0, and Maven
			  would choose it over the 5.18.1 that Testcontainers' Docker client was built
			  against, only because it is nearer in the tree. Pinned at or above the newer, so
			  neither runs on a JNA older than it expects; Dependabot proposes each release.
			  Maintained by the java-native-access project. LGPL-2.1-or-later or Apache-2.0, at
			  the user's choice; which side HrSched relies on is #280. See ADR-044.
			-->
			<dependency>
				<groupId>net.java.dev.jna</groupId>
				<artifactId>jna</artifactId>
				<version>${jna.version}</version>
			</dependency>
			<dependency>
				<groupId>net.java.dev.jna</groupId>
				<artifactId>jna-platform</artifactId>
				<version>${jna.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!--
			  The ephemeral signing key is permitted for `spring-boot:run` and nowhere else.
			  Bound to default-cli, so it reaches goals invoked from the command line and never
			  the repackage goal that builds the jar: a packaged artifact therefore carries no
			  permission to invent a key, and a deployment that forgot HRSCHED_SECURITY_TOKEN_-
			  PRIVATEKEY fails to start rather than signing tokens no other instance can verify.
			  The same mechanism supplies a throwaway local operator to sign in as, following
			  compose.yaml's precedent for the local database: local-only credentials that never
			  reach a packaged jar, and that must be changed at first sign-in anyway. See ADR-011
			  and ADR-029. The plugin itself repackages the jar; maintained by the Spring team,
			  Apache-2.0, its version set by the parent.
			-->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>default-cli</id>
						<configuration>
							<systemPropertyVariables>
								<hrsched.security.token.ephemeral>true</hrsched.security.token.ephemeral>
								<hrsched.bootstrap.operator.sign-in-name>operator</hrsched.bootstrap.operator.sign-in-name>
								<hrsched.bootstrap.operator.password>local-development-only</hrsched.bootstrap.operator.password>
							</systemPropertyVariables>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!--
			  Bound to validate so that a single `./mvnw verify` is the whole gate:
			  format check, build, and tests. CI runs that exact command, so a
			  README-only variant cannot drift away from what actually gates a merge.
			  Maintained by DiffPlug, Apache-2.0, build-time only. See ADR-002.
			-->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless.version}</version>
				<configuration>
					<java>
						<googleJavaFormat>
							<version>${google-java-format.version}</version>
						</googleJavaFormat>
						<removeUnusedImports/>
					</java>
				</configuration>
				<executions>
					<execution>
						<id>spotless-check</id>
						<phase>validate</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!--
			  Coverage is measured and reported, never enforced: there is no `check`
			  goal and no <rules>, so nothing here can fail a build. It is a map of
			  where to look next, read by a person. See ADR-015.

			  The version is pinned because neither spring-boot-dependencies nor
			  spring-boot-starter-parent manages JaCoCo. Maintained by the JaCoCo
			  project. EPL-2.0; it runs at build time only, as the test agent and the
			  report goal, and never reaches the jar.

			  prepare-agent sets the `argLine` property, which surefire reads. Nothing
			  else configures argLine today; anyone adding one must write
			  `@{argLine}` into it, or coverage silently drops to zero while the build
			  stays green.
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<phase>initialize</phase>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
