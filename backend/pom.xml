<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>io.github.naimelijah</groupId>
	<artifactId>hrsched</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>HrSched</name>
	<description>Staff shift scheduling</description>

	<properties>
		<java.version>21</java.version>
		<spotless.version>3.10.4</spotless.version>
		<google-java-format.version>1.27.0</google-java-format.version>
		<archunit.version>1.5.1</archunit.version>
		<jacoco.version>0.8.15</jacoco.version>
		<testcontainers.version>2.0.5</testcontainers.version>
		<!--
		  Not the newest. From 9.13 on, OR-Tools' Windows libraries need the Visual C++ runtime 14.40
		  or later, and the JDK 21 a developer runs here bundles 14.36, which Windows loads first:
		  the JVM crashes on the first solve. 9.12 is the newest that runs on it. Dependabot ignores
		  9.13 and later until that changes. See ADR-044.
		-->
		<ortools.version>9.12.4544</ortools.version>
		<jna.version>5.18.1</jna.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Health and readiness endpoints are a baseline requirement for every service. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!--
		  Vendor-neutral instrumentation, which ADR-001 names as a baseline demand. Supplies the
		  OpenTelemetry API, the Micrometer Tracing bridge over it, and the OTLP exporters, so a
		  W3C trace id exists on every request and reaches the log lines it produces. Apache-2.0, and
		  version-managed by the Boot BOM. See ADR-016.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-opentelemetry</artifactId>
		</dependency>
		<!--
		  Renders the meters Micrometer already collects in the format a scraper reads. Nothing
		  pushes: metrics are pulled from /actuator/prometheus. Apache-2.0, version managed by the
		  Boot BOM through micrometer-bom. See ADR-017.
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!--
		  Storage. JdbcClient and a DataSource, with no ORM: the domain may not carry
		  jakarta.persistence annotations (the architecture test fails on them), so an ORM would need
		  a parallel annotated model anyway and would contribute only behaviour the adapter must not
		  leak. Apache-2.0, version-managed by the Boot BOM. See ADR-004.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<!--
		  Versioned schema migrations as plain SQL, applied on startup. Chosen over Liquibase because
		  the migrations are SQL and Flyway lets them stay SQL. Apache-2.0, BOM-managed. See ADR-004.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<!-- The driver. Runtime only: nothing compiles against it. BSD-2-Clause, BOM-managed. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!--
		  Starts the Postgres in compose.yaml when the application is run locally, and stops it after.
		  Optional, so it never reaches a deployed artifact; Boot skips it under test, where
		  Testcontainers supplies the database instead. Keeps scripts/run.mjs free of build logic,
		  which ADR-014 requires of it. Apache-2.0, BOM-managed.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-docker-compose</artifactId>
			<optional>true</optional>
		</dependency>

		<!--
		  Spring Security's filter chain, plus JWT signing and verification (Nimbus JOSE+JWT) for
		  the access tokens ADR-011 issues. Added now, ahead of any token, because putting Spring
		  Security on the classpath locks every request behind authentication by default;
		  SecurityConfiguration replaces that default with one chain that permits every request, so
		  the dependency and the tightening it enables can land separately. Apache-2.0,
		  version-managed by the Boot BOM. See ADR-011.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
		</dependency>

		<!--
		  Roster generation: CP-SAT, the constraint solver in Google OR-Tools, reached over JNI. It
		  replaces the greedy placeholder ADR-005 shipped; an exact optimiser for a 0-1 problem of
		  this size is not something to write by hand. Brings native libraries for five platforms
		  and protobuf-java, which the Boot BOM already manages. Confined to
		  scheduling.adapter.out.generation. Apache-2.0, maintained by Google, and pinned because no
		  BOM manages it. See ADR-044.
		-->
		<dependency>
			<groupId>com.google.ortools</groupId>
			<artifactId>ortools-java</artifactId>
			<version>${ortools.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  Enforces the hexagon. Nothing in the JDK, Maven, or Spring can fail a build when the
		  domain imports a framework type; without this the dependency rule is only a comment.
		  Apache-2.0, actively maintained. See ADR-003.
		-->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
		<!--
		  The tests run against a real PostgreSQL in a container, so Docker is required to build.
		  There is deliberately no in-memory fallback and no skip-when-Docker-is-absent: a check that
		  quietly does not run still reports green, which is what ci.yml already refuses for path
		  filters. MIT, and pinned here because the Boot BOM does not manage the Testcontainers
		  modules. See ADR-004.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>${testcontainers.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!--
			  OR-Tools asks for JNA 5.14.0, and Maven would choose it over the 5.18.1 that
			  Testcontainers' Docker client was built against, only because it is nearer in the
			  tree. Pinned to the newer, so neither runs on a JNA older than it expects.
			  LGPL-2.1-or-later or Apache-2.0, at the user's choice. See ADR-044.
			-->
			<dependency>
				<groupId>net.java.dev.jna</groupId>
				<artifactId>jna</artifactId>
				<version>${jna.version}</version>
			</dependency>
			<dependency>
				<groupId>net.java.dev.jna</groupId>
				<artifactId>jna-platform</artifactId>
				<version>${jna.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!--
			  The ephemeral signing key is permitted for `spring-boot:run` and nowhere else.
			  Bound to default-cli, so it reaches goals invoked from the command line and never
			  the repackage goal that builds the jar: a packaged artifact therefore carries no
			  permission to invent a key, and a deployment that forgot HRSCHED_SECURITY_TOKEN_-
			  PRIVATEKEY fails to start rather than signing tokens no other instance can verify.
			  The same mechanism supplies a throwaway local operator to sign in as, following
			  compose.yaml's precedent for the local database: local-only credentials that never
			  reach a packaged jar, and that must be changed at first sign-in anyway. See ADR-011
			  and ADR-029.
			-->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>default-cli</id>
						<configuration>
							<systemPropertyVariables>
								<hrsched.security.token.ephemeral>true</hrsched.security.token.ephemeral>
								<hrsched.bootstrap.operator.sign-in-name>operator</hrsched.bootstrap.operator.sign-in-name>
								<hrsched.bootstrap.operator.password>local-development-only</hrsched.bootstrap.operator.password>
							</systemPropertyVariables>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!--
			  Bound to validate so that a single `./mvnw verify` is the whole gate:
			  format check, build, and tests. CI runs that exact command, so a
			  README-only variant cannot drift away from what actually gates a merge.
			-->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless.version}</version>
				<configuration>
					<java>
						<googleJavaFormat>
							<version>${google-java-format.version}</version>
						</googleJavaFormat>
						<removeUnusedImports/>
					</java>
				</configuration>
				<executions>
					<execution>
						<id>spotless-check</id>
						<phase>validate</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!--
			  Coverage is measured and reported, never enforced: there is no `check`
			  goal and no <rules>, so nothing here can fail a build. It is a map of
			  where to look next, read by a person. See ADR-015.

			  The version is pinned because neither spring-boot-dependencies nor
			  spring-boot-starter-parent manages JaCoCo.

			  prepare-agent sets the `argLine` property, which surefire reads. Nothing
			  else configures argLine today; anyone adding one must write
			  `@{argLine}` into it, or coverage silently drops to zero while the build
			  stays green.
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<phase>initialize</phase>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
