# The repository is authoritative on line endings, not each contributor's core.autocrlf.
# Kept in sync with .editorconfig by hand; if you change one, change the other.

* text=auto eol=lf

# Windows shells choke on LF in scripts they execute.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.ico  binary
