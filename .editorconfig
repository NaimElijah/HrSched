# Kept in sync with .gitattributes by hand; if you change one, change the other.
# For Java, Spotless + google-java-format is authoritative (see pom.xml) — the settings
# below only stop an editor fighting the formatter between runs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# google-java-format is fixed at 2-space indentation and is not configurable.
[*.java]
indent_size = 2

[*.{json,jsonc,yml,yaml,toml,xml,html,css,js,jsx,ts,tsx}]
indent_size = 2

# Generated by Spring Initializr, which uses tabs. No formatter owns this file, so the
# setting describes what is actually there rather than what would be tidier.
[pom.xml]
indent_style = tab

[*.md]
# Markdown gives meaning to a two-space line ending; trimming it silently joins lines.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf

# Maven wrapper scripts are generated; leave them exactly as shipped.
[mvnw*]
insert_final_newline = false
trim_trailing_whitespace = false
